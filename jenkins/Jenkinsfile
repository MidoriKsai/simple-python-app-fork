def selectedArtist = ''
def selectedGenre = ''

pipeline {
    agent {
        docker {
            image 'dh-mirror.gitverse.ru/python:3.13.7-alpine3.22'
            args '--user root'
        }
    }

    options {
        timeout(time: 3, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'ВАШ_ЛЮБИМЫЙ_ИСПОЛНИТЕЛЬ',
            defaultValue: 'Artur Pirozhkov',
            description: 'Введите любимого исполнителя'
        )

        choice(
            name: 'ЖАНР',
            choices: ['Pop', 'Rock', 'Rap'],
            description: 'Выберите музыкальный жанр'
        )
    }

    triggers {
        cron('H/15 * * * *')
    }

    environment {
        FAVORITE_ARTIST = "${params['ВАШ_ЛЮБИМЫЙ_ИСПОЛНИТЕЛЬ']}"
        FAVORITE_GENRE = "${params['ЖАНР']}"
        FAVORITE_SONG = 'Чика'

        ARTIST_CREDENTIALS = credentials('artist-credentials')
    }

    stages {

        stage('Show environment') {
            steps {
                echo "FAVORITE_ARTIST = ${env.FAVORITE_ARTIST}"
                echo "FAVORITE_GENRE = ${env.FAVORITE_GENRE}"
                echo "FAVORITE_SONG = ${env.FAVORITE_SONG}"

                echo "PARAM ARTIST = ${params['ВАШ_ЛЮБИМЫЙ_ИСПОЛНИТЕЛЬ']}"
                echo "PARAM GENRE = ${params['ЖАНР']}"

                sh '''
                    echo "Username = $ARTIST_CREDENTIALS_USR"
                    echo "Password = $ARTIST_CREDENTIALS_PSW"
                '''
            }
        }

        stage('Retry Demo') {
            options {
                retry(2)
            }

            steps {
                sh '''
                    if [ ! -f .retry_test ]; then
                        echo "Первая попытка — ошибка"
                        touch .retry_test
                        exit 1
                    fi

                    echo "Повторная попытка — успешно"
                    rm -f .retry_test
                '''
            }
        }

        stage('Input') {
            steps {
                script {
                    def result = input(
                        message: 'Измените параметры',
                        ok: 'Продолжить',
                        parameters: [
                            [
                                $class: 'ChoiceParameterDefinition',
                                name: 'NEW_ARTIST',
                                choices: "Artur Pirozhkov\nРокеры\nПопсы",
                                description: 'Выберите любимого исполнителя'
                            ],
                            [
                                $class: 'ChoiceParameterDefinition',
                                name: 'NEW_GENRE',
                                choices: "Pop\nRock\nRap",
                                description: 'Выберите жанр'
                            ]
                        ]
                    )

                    selectedArtist = result.get('NEW_ARTIST')
                    selectedGenre = result.get('NEW_GENRE')

                    echo "Выбранный исполнитель: ${selectedArtist}"
                    echo "Выбранный жанр: ${selectedGenre}"
                }
            }
        }

        stage('Rockers') {
            when {
                expression {
                    selectedArtist == 'Рокеры'
                }
            }

            steps {
                echo 'Играет рок-группа!'
            }
        }

        stage('Pop') {
            when {
                expression {
                    selectedArtist == 'Попсы'
                }
            }

            steps {
                echo 'Играет поп-группа!'
            }
        }

        stage('Artur Pirozhkov') {
            when {
                expression {
                    selectedArtist == 'Artur Pirozhkov'
                }
            }

            steps {
                echo 'Играет Artur Pirozhkov!'
            }
        }

        stage('Setup') {
            steps {
                sh '''
                    python -m venv venv
                    . venv/bin/activate
                    pip install -r requirements.txt
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                    . venv/bin/activate
                    python -m py_compile sources/add2vals.py sources/calc.py
                '''

                stash(
                    name: 'compiled-results',
                    includes: 'sources/**/*.py*'
                )
            }
        }

        stage('Test') {
            steps {
                sh '''
                    . venv/bin/activate
                    mkdir -p test-reports
                    py.test --junit-xml test-reports/results.xml sources/test_calc.py
                '''
            }

            post {
                always {
                    junit 'test-reports/results.xml'
                }
            }
        }
    }
}
